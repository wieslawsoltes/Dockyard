{
  "name": "avalondock-web",
  "version": "0.1.0",
  "type": "module",
  "description": "Independent AvalonDock-style docking components for the web, with a PascalCase JavaScript model API",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./model": {
      "types": "./src/model.d.ts",
      "import": "./src/model.js"
    },
    "./styles.css": "./src/avalondock.css"
  },
  "files": [
    "src",
    "dist",
    "docs",
    "sample/minimal.html",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python tests/browser.py",
    "serve": "python -m http.server 8080 --bind 127.0.0.1",
    "check": "tsc --noEmit --strict --lib es2022,dom --module nodenext --moduleResolution nodenext tests/types.ts",
    "api": "node scripts/api-surface.mjs"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "./src/avalondock.css",
    "./src/web-component.js",
    "./src/index.js",
    "./dist/avalondock.js"
  ]
}
