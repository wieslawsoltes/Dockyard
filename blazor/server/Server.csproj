<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup><TargetFramework Condition="'$(TargetFramework)' == ''">net8.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><RootNamespace>Dockyard.Blazor.Server</RootNamespace></PropertyGroup>
  <Import Project="../Version.props" />
  <ItemGroup>
    <ProjectReference Include="../src/Dockyard.Blazor.csproj" Condition="'$(UsePackage)' != 'true'" />
    <PackageReference Include="Dockyard.Blazor" Version="$(Version)" Condition="'$(UsePackage)' == 'true'" />
    <Content Include="../sample/Demo.razor" Link="Demo.razor" />
    <Content Include="../sample/InteropProbe.razor" Link="InteropProbe.razor" />
    <Content Include="../sample/wwwroot/probe.js" Link="wwwroot/probe.js" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
