@namespace DockyardBlazorSample
@using Dockyard.Blazor
@using System.Text.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
<section aria-label="Blazor integration verification">
    <h2>Razor templates and streamed interop</h2>
    <BrowserTemplate TItem="JsonElement" Id="@_templateId" Context="context">
        <p>@context.GetProperty("label").GetString()</p>
        <button id="template-counter" @onclick="Increment">Razor count: @_count</button>
        <input id="template-input" aria-label="Template input" @bind="_text" />
        <output id="template-value">@_text</output>
    </BrowserTemplate>
    <div @ref="_host"></div>
    <output id="interop-status">@_status</output>
</section>
@code {
    private readonly string _templateId = Guid.NewGuid().ToString("N");
    private ElementReference _host;
    private BrowserModule? _module;
    private IJSObjectReference? _mount;
    private int _count;
    private string _text = "Initial", _status = "Loading";
    private bool _disposed;
    private void Increment() => _count++;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _module = new BrowserModule(JS, "./probe.js");
        var probe = await _module.CreateAsync("Probe");
        await using var function = await _module.InvokeReferenceAsync("CreateFunction", [3]);
        if (await _module.CallFunctionAsync<int>(function, [4]) != 7 || await _module.InvokeAsync<int>("ApplyFunction", [function, 5]) != 8) throw new InvalidOperationException("Native function reference failed.");
        if (await _module.CallFunctionJsonAsync<int>(function, [8]) != 11) throw new InvalidOperationException("Streamed function invocation failed.");
        var literal = new Dictionary<string, string> { ["$fn"] = "module", ["url"] = "./must-not-load.js" };
        var echoed = await _module.CallJsonAsync<Dictionary<string, string>>(probe, "Echo", [BrowserValue.Literal(literal)]);
        if (echoed["$fn"] != "module") throw new InvalidOperationException("Literal application data was interpreted as code.");
        var large = string.Concat(Enumerable.Repeat("Zażółć 🙂", 20000));
        var received = new TaskCompletionSource<string>(TaskCreationOptions.RunContinuationsAsynchronously);
        await using (var subscription = await _module.SubscribeJsonAsync<string>(probe, "Changed", value => { received.TrySetResult(value); return Task.CompletedTask; }))
        {
            await _module.CallVoidAsync(probe, "Set", [large]);
            if (await received.Task.WaitAsync(TimeSpan.FromSeconds(20)) != large) throw new InvalidOperationException("Streamed notification was truncated.");
        }
        if (await _module.GetJsonAsync<string>(probe, "value") != large) throw new InvalidOperationException("Streamed property did not round trip.");
        if (await _module.CallJsonAsync<string>(probe, "Echo", [large]) != large) throw new InvalidOperationException("Streamed invocation did not round trip.");
        var bytes = await _module.CallBytesAsync(probe, "Bytes");
        if (bytes.Length != 100000 || bytes.Where((value, i) => value != i % 251).Any()) throw new InvalidOperationException("Binary stream was corrupted.");
        var batch = await _module.CallBatchAsync([new(probe, "Echo", [4]), new(probe, "Echo", ["batch"])]);
        if (batch[0].GetInt32() != 4 || batch[1].GetString() != "batch") throw new InvalidOperationException("Batch order changed.");
        _mount = await _module.InvokeAsync<IJSObjectReference>("MountTemplate", [_host, BrowserFunction.RazorTemplate(_templateId)]);
        _status = "Passed";
        if (!_disposed) StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { if (_mount is not null) await _module.ReleaseAsync(_mount); }
        catch (JSDisconnectedException) { }
        finally { await _module.DisposeAsync(); }
    }
}
